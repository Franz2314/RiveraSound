# =============================================================================
# RiveraSound · Variables de entorno del backend
# Copia este archivo como ".env" (en esta misma carpeta) y ajusta los valores.
# El .env NO se sube a GitHub (está en .gitignore).
# =============================================================================

# Puerto donde corre la API y el sitio web (http://localhost:3000)
PORT=3000

# -----------------------------------------------------------------------------
# PostgreSQL (base de datos PRINCIPAL: catálogo, usuarios, pedidos)
# -----------------------------------------------------------------------------
PG_HOST=localhost
PG_PORT=5432
PG_DATABASE=riverasound
PG_USER=rs_app
PG_PASSWORD=rs_app_123

# Superusuario: solo lo usa "npm run db:init" para crear la base la 1.a vez
PG_ADMIN_USER=postgres
PG_ADMIN_PASSWORD=tu_clave_de_postgres

# -----------------------------------------------------------------------------
# MongoDB  (true = intentar conectar; false = ignorar)
# -----------------------------------------------------------------------------
MONGO_HABILITADO=false
MONGO_URI=mongodb://localhost:27017
MONGO_DB=riverasound

# -----------------------------------------------------------------------------
# Cassandra
#   WSL/Ubuntu o Docker exponen el puerto 9042 en localhost.
#   El datacenter por defecto de Cassandra es "datacenter1".
#   Usuario/clave solo si activaste PasswordAuthenticator.
# -----------------------------------------------------------------------------
CASSANDRA_HABILITADO=false
CASSANDRA_PUNTOS_CONTACTO=127.0.0.1
CASSANDRA_PUERTO=9042
CASSANDRA_DATACENTER=datacenter1
CASSANDRA_KEYSPACE=riverasound
CASSANDRA_USUARIO=
CASSANDRA_CLAVE=

# -----------------------------------------------------------------------------
# Oracle (XE 21c: servicio XEPDB1, puerto 1521)
# -----------------------------------------------------------------------------
ORACLE_HABILITADO=false
ORACLE_USUARIO=riverasound
ORACLE_CLAVE=riverasound_123
ORACLE_CADENA=localhost:1521/XEPDB1
